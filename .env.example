# dormitory-bot — переменные окружения
# Скопируйте в .env и заполните

# MAX Messenger
MAX_BOT_TOKEN=
ENCRYPTION_KEY=
SEED_MODE=production
TIMEZONE=Asia/Irkutsk

# PostgreSQL (собственная БД бота)
DATABASE_USER=dormitory_user
DATABASE_PASSWORD=
DATABASE_DBNAME=dormitory_db
DATABASE_SSLMODE=disable

# Redis
REDIS_PASSWORD=

# RabbitMQ (общая шина с eis-adapter)
RABBITMQ_URL=amqp://dormitory:***@host.docker.internal:5672/
RABBITMQ_EXCHANGE_NAME=dormitory.eis
RABBITMQ_USER=dormitory
RABBITMQ_PASSWORD=

# Mock mode: включить для работы без eis-adapter и RabbitMQ
MOCK_MODE=false

# JWT (Mini App API)
# Если не задан, используется ENCRYPTION_KEY
JWT_SECRET=

# Mini App URL (для генерации deep link)
MINI_APP_URL=https://example.com
BOT_NAME=

# EIS MySQL (для SyncTrigger — бот передаёт эти креды адаптеру)
UNIVERSITY_DB_HOST=
UNIVERSITY_DB_PORT=3306
UNIVERSITY_DB_USER=
UNIVERSITY_DB_PASSWORD=
UNIVERSITY_DB_DBNAME=
